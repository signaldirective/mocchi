#!/bin/bash
# mocchi-start — first-load wiring, then (optionally) the greeting toast.
#
# Omarchy plugins are plain checkouts with no installer step, so Mocchi does its
# own tiny setup when the shell mounts the widget. It is deliberately small and
# safe to run on every shell start:
#
#   1. Links the bundled skill into ~/.agents/skills/mocchi so OpenCode (and
#      other agents) discover it — the same way Omarchy wires its own `omarchy`
#      and `diagnose-crash` skills. An existing link or file is never touched.
#   2. Adds the skill's always-on digest to OpenCode's `instructions`, but only
#      when it is missing, and only after backing the config up.
#
# Then it hands the greeting decision to `mocchi-greeting`, which owns that
# state for both this path and the widget's right-click menu.
#
# $1 = greeting mode (on-restart | once | off)
# $2 = skill wiring  (auto | off)

set -euo pipefail

mode="${1:-on-restart}"
skill="${2:-auto}"

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin_dir=$(dirname -- "$self_dir")
skill_dir="$plugin_dir/skills/mocchi"

# --- 1. make the bundled skill discoverable --------------------------------
link="$HOME/.agents/skills/mocchi"
if [[ $skill != off && -f $skill_dir/SKILL.md ]]; then
  mkdir -p "$(dirname "$link")"
  if [[ ! -e $link && ! -L $link ]]; then
    ln -s "$skill_dir" "$link"
  fi
fi

# --- 2. keep the always-on digest registered -------------------------------
instructions="$link/instructions.md"
config="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
if [[ $skill != off && -f $instructions && -f $config ]] &&
  command -v jq >/dev/null 2>&1 &&
  jq -e . "$config" >/dev/null 2>&1 &&
  ! jq -e --arg i "$instructions" '(.instructions // []) | index($i)' "$config" >/dev/null 2>&1; then
  [[ -f $config.mocchi.bak ]] || cp -n "$config" "$config.mocchi.bak" 2>/dev/null || true
  tmp=$(mktemp)
  if jq --arg i "$instructions" \
    '.instructions = (((.instructions // []) + [$i]) | unique)' "$config" >"$tmp"; then
    # Write in place so the file's permissions survive and a symlinked config
    # (common with dotfile managers) is followed rather than replaced.
    cat "$tmp" >"$config"
  fi
  rm -f "$tmp"
fi

# --- 3. optionally say hello ------------------------------------------------
# Greeting state — the silences, the throttle, the "used" marker — lives in
# scripts/mocchi-greeting, so the widget's right-click menu can switch it off
# without a second copy of the rules.
exec bash "$self_dir/mocchi-greeting" show "$mode"
